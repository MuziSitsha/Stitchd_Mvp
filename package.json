{
  "name": "stitchd-platform",
  "version": "1.0.0",
  "private": true,
  "description": "STITCHD - On-Demand Services Platform for South Africa",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
